# ---------------------------------------------------------------------------
# Configuration — copier en .env et adapter. Ne jamais committer .env.
# ---------------------------------------------------------------------------

# --- Base de données -------------------------------------------------------
# Dialecte cible : postgresql | mysql | sqlserver | sqlite
# Après changement : npm run db:provider && npm run db:generate
DATABASE_PROVIDER=postgresql

# PostgreSQL (cible certifiée par défaut)
DATABASE_URL="postgresql://scoring:motdepasse@localhost:5432/scoring?schema=public"

# Exemples pour les autres dialectes :
# DATABASE_URL="mysql://scoring:motdepasse@localhost:3306/scoring"
# DATABASE_URL="sqlserver://localhost:1433;database=scoring;user=scoring;password=motdepasse;encrypt=true;trustServerCertificate=true"
# DATABASE_URL="file:./dev.db"   # SQLite — développement uniquement

# --- Sécurité API ----------------------------------------------------------
# Format : "<clé>:<rôle>:<nom>;<clé2>:<rôle2>:<nom2>"
# Rôles : READONLY | ANALYST | RISK_MANAGER | ADMIN
# Clé de 16 caractères minimum. Aucun secret par défaut : sans cette variable,
# l'API refuse toute requête authentifiée en production.
# Générer une clé : openssl rand -hex 32
API_KEYS=""

# --- Divers ----------------------------------------------------------------
NODE_ENV=development
