# ---------------------------------------------------------------------------
# Configuration — copier en .env et adapter. Ne jamais committer .env.
# ---------------------------------------------------------------------------

# --- Dialecte de base de données -------------------------------------------
# postgresql | mysql | sqlserver | sqlite
# Après changement : npm run db:provider && npm run db:generate
DATABASE_PROVIDER=postgresql

# ===========================================================================
# OPTION A — Supabase (démarrage)
# ===========================================================================
# Les tables vivent dans le schéma dédié « corp_scoring », jamais dans
# « public ». Ce schéma n'est pas exposé par PostgREST : la clé anon, publique
# par nature, ne peut donc atteindre aucune donnée de notation.
#
# Récupérer les chaînes dans : Supabase > Project Settings > Database.
#
# DATABASE_URL  : pooler en mode transaction (port 6543) — utilisé par l'app.
#                 « pgbouncer=true » est OBLIGATOIRE : le pooler ne supporte
#                 pas les requêtes préparées de Prisma.
# DIRECT_URL    : connexion directe (port 5432) — utilisée par les migrations,
#                 qui ne peuvent pas passer par un pooler de transactions.
#
# DATABASE_URL="postgresql://postgres.<REF>:<MOT_DE_PASSE>@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&schema=corp_scoring&sslmode=require"
# DIRECT_URL="postgresql://postgres.<REF>:<MOT_DE_PASSE>@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?schema=corp_scoring&sslmode=require"

# ===========================================================================
# OPTION B — PostgreSQL autonome (cible)
# ===========================================================================
# Sans pooler, DIRECT_URL prend la même valeur que DATABASE_URL.
DATABASE_URL="postgresql://scoring:motdepasse@localhost:5432/scoring?schema=corp_scoring"
DIRECT_URL="postgresql://scoring:motdepasse@localhost:5432/scoring?schema=corp_scoring"

# ===========================================================================
# Autres dialectes
# ===========================================================================
# DATABASE_URL="mysql://scoring:motdepasse@localhost:3306/scoring"
# DATABASE_URL="sqlserver://localhost:1433;database=scoring;user=scoring;password=motdepasse;encrypt=true"
# DATABASE_URL="file:./dev.db"   # SQLite — développement uniquement

# --- Sécurité API ----------------------------------------------------------
# Format : "<clé>:<rôle>:<nom>;<clé2>:<rôle2>:<nom2>"
# Rôles : READONLY | ANALYST | RISK_MANAGER | ADMIN
# Clé de 24 caractères minimum. AUCUN SECRET PAR DÉFAUT : sans cette variable,
# l'API refuse toute requête authentifiée et le démarrage échoue en production.
# Générer une clé : openssl rand -hex 32
API_KEYS=""

# --- Réseau et limitation de débit -----------------------------------------
# Origines autorisées pour les appels navigateur (liste blanche, séparées par
# des virgules). Vide = aucune origine croisée autorisée.
CORS_ALLOWED_ORIGINS=""

# Requêtes par minute et par clé API (0 = illimité, déconseillé en production).
RATE_LIMIT_PER_MINUTE=120

# Taille maximale d'un corps de requête, en kilo-octets.
MAX_REQUEST_BODY_KB=512

# Autorise les URL de webhook pointant vers des adresses privées.
# À laisser à 0 en production : protège contre les requêtes forgées côté
# serveur vers le réseau interne (SSRF).
ALLOW_PRIVATE_WEBHOOK_URLS=0

# --- Divers ----------------------------------------------------------------
NODE_ENV=development
