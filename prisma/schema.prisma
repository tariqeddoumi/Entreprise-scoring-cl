// FICHIER GÉNÉRÉ par scripts/set-db-provider.mjs (provider: postgresql).
// Modifier prisma/schema.template.prisma, puis relancer `npm run db:provider`.

// ---------------------------------------------------------------------------
// SOURCE CANONIQUE DU SCHÉMA — NE PAS ÉDITER prisma/schema.prisma DIRECTEMENT.
//
// `npm run db:provider` génère prisma/schema.prisma depuis ce template, en
// fonction de DATABASE_PROVIDER (postgresql | mysql | sqlserver | sqlite).
// La génération est idempotente : elle repart toujours de ce fichier, ce qui
// évite toute perte d'annotation entre deux dialectes.
//
// Schéma volontairement portable multi-SGBD :
//  - identifiants String (cuid), jamais de séquence métier par count + 1 ;
//  - aucun enum natif (compatibilité SQL Server / SQLite) — les valeurs sont
//    validées applicativement par Zod ;
//  - payloads JSON stockés en texte, sans dépendance à JSONB ;
//  - montants, scores et taux en Decimal, jamais en flottant binaire.
//
// Substitutions appliquées par le script :
//   @db.Text        -> @db.LongText (MySQL) | @db.NVarChar(Max) (SQL Server) | supprimé (SQLite)
//   @db.Decimal(...)-> conservé | supprimé (SQLite, qui ne gère pas la précision)
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Connexion directe pour les migrations (facultative hors pooler).
  directUrl = env("DIRECT_URL")
}

// --- Organisation : groupe, banques, filiales ------------------------------
//
// Arbre de profondeur quelconque stocké en chemin matérialisé (« /racine/…/id/ ») :
// la descendance d'une entité se lit en une comparaison de préfixe. Chaque
// utilisateur, contrepartie et dossier appartient à une entité ; le
// cloisonnement (src/lib/scope.ts) en découle : une entité voit sa descendance,
// jamais sa maison mère ni ses sœurs.

model Entity {
  id           String   @id @default(cuid())
  code         String   @unique // code court, ex. BCP, BP-CASA, BA-CI
  name         String
  type         String // GROUP | BANK | REGIONAL_BANK | SUBSIDIARY_GROUP | SUBSIDIARY
  parentId     String?
  parent       Entity?  @relation("EntityTree", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children     Entity[] @relation("EntityTree")
  path         String // chemin matérialisé : celui du parent suivi de l'identifiant
  level        Int      @default(0)
  country      String? // ISO 3166-1 alpha-2 (MA, CI, SN…)
  currency     String   @default("MAD") // ISO 4217 — devise de référence de l'entité
  isActive     Boolean  @default(true)
  // Habillage : une valeur vide est héritée de l'entité mère la plus proche.
  toolName     String?
  logoUrl      String?
  primaryColor String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users          User[]
  counterparties Counterparty[]

  @@index([path])
  @@map("entities")
}

// Cours de change datés : nombre d'unités de la devise de base du groupe
// (BASE_CURRENCY, MAD) pour une unité de la devise. Un montant saisi dans la
// devise d'une filiale est converti au cours en vigueur à la date d'arrêté,
// et la conversion est consignée dans le dossier.
model ExchangeRate {
  id            String   @id @default(cuid())
  currency      String // ISO 4217
  rate          Decimal  @db.Decimal(18, 8)
  effectiveDate String // AAAA-MM-JJ
  source        String?
  createdBy     String
  createdAt     DateTime @default(now())

  @@unique([currency, effectiveDate])
  @@map("exchange_rates")
}

// Paramétrage de l'outil (règles du workflow, IA, documents). Chaque
// modification est journalisée ; les secrets n'y sont jamais enregistrés.
model AppSetting {
  key       String   @id
  value     String   @db.Text
  updatedBy String
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

// --- Référentiel contreparties ---------------------------------------------

model Counterparty {
  id         String   @id @default(cuid())
  name       String
  entityId   String // banque ou filiale qui porte la relation
  entity     Entity   @relation(fields: [entityId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  country    String? // ISO 3166-1 alpha-2
  currency   String   @default("MAD") // devise des montants de la contrepartie
  // Identifiants marocains — alimentés depuis le référentiel autoritatif.
  ice        String? // Identifiant Commun de l'Entreprise (unique par entité)
  rc         String? // Registre de commerce
  fiscalId   String? // Identifiant fiscal
  legalForm  String?
  sectorCode String? // code du référentiel sectoriel interne
  city       String?
  segment    String? // TPE | PME | GE — dernier segment calculé (indicatif)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  ratingRuns  RatingRun[]
  ratingCases RatingCase[]

  @@unique([entityId, ice])
  @@index([name])
  @@index([entityId])
  @@map("counterparties")
}

// --- Runs de notation -------------------------------------------------------

model RatingRun {
  id             String       @id @default(cuid())
  counterpartyId String
  counterparty   Counterparty @relation(fields: [counterpartyId], references: [id])

  modelId       String
  modelVersion  String
  engineVersion String
  asOfDate      String // date d'arrêté ISO (temps métier, distinct du temps système)
  segment       String?
  // Statut de notation, recopié tel quel depuis `RatingResult.ratingStatus`.
  // Vocabulaire V3 : RATED | DEFAULTED | NO_RATING_INSUFFICIENT_DATA |
  // NO_RATING_SEGMENT_UNDETERMINED | NO_RATING_ROUTED_OTHER_MODEL.
  // Les lignes produites par le moteur v1 portent l'ancien vocabulaire
  // (SCORED, BLOCKED_*, DEFAULT_GRADE, NO_GRADE_CONFIDENCE) : un filtre SQL
  // écrit pour l'un ne ramène rien sur l'autre.
  outcome       String

  rawScore        Decimal? @db.Decimal(9, 4)
  confidenceScore Decimal? @db.Decimal(9, 4)
  engineGrade     String? // grade issu du score, avant exception non compensatoire
  // Grade produit par le moteur — exceptions non compensatoires ET support
  // groupe compris. Immuable : c'est la référence d'une dérogation.
  cappedGrade     String?
  finalGrade      String? // après override approuvé le cas échéant

  // Snapshots immuables (reproductibilité) — JSON sérialisé de façon stable.
  inputSnapshot  String @db.Text
  resultSnapshot String @db.Text

  requestedBy    String // identité dérivée du jeton, jamais du corps de requête
  idempotencyKey String?  @unique
  createdAt      DateTime @default(now())

  overrides Override[]
  ratingCase RatingCase?

  @@index([counterpartyId, createdAt])
  @@index([modelId, asOfDate])
  @@map("rating_runs")
}

// --- Overrides (maker-checker) ----------------------------------------------

model Override {
  id          String    @id @default(cuid())
  ratingRunId String
  ratingRun   RatingRun @relation(fields: [ratingRunId], references: [id])

  fromGrade  String // grade moteur/capé conservé, jamais écrasé
  toGrade    String
  reasonCode String // motif codifié (DATA_NOT_CAPTURED, GROUP_SUPPORT, ...)
  comment    String  @db.Text
  evidence   String? @db.Text

  requestedBy     String // maker — dérivé du jeton
  decidedBy       String? // checker — doit différer du maker
  status          String  @default("PENDING") // PENDING | APPROVED | REJECTED
  decisionComment String? @db.Text

  createdAt DateTime  @default(now())
  decidedAt DateTime?
  expiresAt DateTime?

  @@index([ratingRunId])
  @@map("overrides")
}

// --- Webhooks ----------------------------------------------------------------

model WebhookSubscription {
  id        String   @id @default(cuid())
  url       String
  secret    String // secret HMAC — jamais renvoyé en clair après création
  events    String   @db.Text // JSON array : ["rating.completed", ...]
  isActive  Boolean  @default(true)
  createdBy String
  createdAt DateTime @default(now())

  deliveries WebhookDelivery[]

  @@map("webhook_subscriptions")
}

model WebhookDelivery {
  id             String              @id @default(cuid())
  subscriptionId String
  subscription   WebhookSubscription @relation(fields: [subscriptionId], references: [id])

  eventId   String
  eventType String
  payload   String  @db.Text
  status    String  @default("PENDING") // PENDING | DELIVERED | FAILED
  attempts  Int     @default(0)
  lastError String? @db.Text

  createdAt   DateTime  @default(now())
  deliveredAt DateTime?

  @@index([subscriptionId, createdAt])
  @@map("webhook_deliveries")
}

// --- Audit (append-only applicatif) ------------------------------------------

model AuditEvent {
  id            String   @id @default(cuid())
  actor         String // identité issue du contexte de sécurité
  actorRole     String?
  action        String // ex. RATING_RUN_CREATED, OVERRIDE_APPROVED
  resourceType  String
  resourceId    String
  entityId      String? // entité du dossier concerné ; nul pour un événement général
  detail        String?  @db.Text // JSON : valeurs avant/après, motif
  correlationId String?
  createdAt     DateTime @default(now())

  @@index([resourceType, resourceId])
  @@index([entityId, createdAt])
  @@index([createdAt])
  @@map("audit_events")
}

// --- Comptes utilisateurs de l'interface web -------------------------------
//
// Comptes nominatifs : la piste d'audit désigne une personne, non un rôle
// partagé. Les clés API (variable API_KEYS) restent réservées aux échanges
// entre systèmes et ne permettent plus d'ouvrir une session dans l'interface.
//
// Le mot de passe n'est jamais stocké : seule son empreinte scrypt salée l'est.
// Ce mécanisme est provisoire par nature — le raccordement au fournisseur
// d'identité de la banque (OIDC/SAML) le remplacera sans changer le reste :
// l'identité et le rôle continuent de provenir de la session.

model User {
  id                 String    @id @default(cuid())
  username           String    @unique // minuscules, [a-z0-9._-]
  displayName        String
  role               String // READONLY | ANALYST | RISK_MANAGER | ADMIN
  passwordHash       String // scrypt$N$r$p$sel$empreinte
  mustChangePassword Boolean   @default(true)
  isActive           Boolean   @default(true)
  failedAttempts     Int       @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  passwordChangedAt  DateTime?
  createdBy          String?
  // Entité de rattachement. Nul : administrateur du groupe (rôle ADMIN), sinon
  // aucun accès tant qu'un administrateur ne l'a pas rattaché.
  entityId           String?
  entity             Entity?   @relation(fields: [entityId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  // ENTITY : écrit dans sa seule entité ; BRANCH : dans toute sa descendance.
  writeScope         String    @default("ENTITY")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  sessions UserSession[]

  @@map("users")
}

// Session ouverte dans l'interface. Le cookie porte un jeton aléatoire ; la
// base n'en garde que l'empreinte SHA-256, qui sert d'identifiant. Une session
// se révoque côté serveur : déconnexion, changement ou réinitialisation du mot
// de passe, désactivation du compte.
model UserSession {
  id         String    @id // SHA-256 hexadécimal du jeton
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  userAgent  String?

  @@index([userId])
  @@map("user_sessions")
}

// --- Dossiers de notation (workflow) ----------------------------------------
//
// Un dossier porte la saisie en cours (brouillon enregistré), puis la notation
// calculée à la soumission (RatingRun, immuable), puis la décision d'un
// valideur distinct de l'auteur. Seule une notation validée devient la note
// de la contrepartie.
//
// DRAFT -> SUBMITTED -> VALIDATED | REJECTED ; un dossier rejeté se reprend
// en brouillon. CANCELLED : abandonné par son auteur avant soumission.

model RatingCase {
  id              String       @id @default(cuid())
  counterpartyId  String
  counterparty    Counterparty @relation(fields: [counterpartyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  modelId         String
  asOfDate        String // AAAA-MM-JJ
  status          String       @default("DRAFT")
  // Saisie du formulaire (JSON), enregistrée au fil de l'eau.
  draftInput      String       @db.Text
  // Conversion des montants dans la devise de base, consignée à la soumission.
  fxDetail        String?      @db.Text
  runId           String?      @unique
  run             RatingRun?   @relation(fields: [runId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdBy       String
  submittedBy     String?
  submittedAt     DateTime?
  decidedBy       String?
  decidedAt       DateTime?
  decisionComment String?      @db.Text
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  documents CaseDocument[]
  proposals AiProposal[]

  @@index([counterpartyId, createdAt])
  @@index([status])
  @@map("rating_cases")
}

// Pièce d'un dossier (états financiers, rapport, statuts…). Stockée en base
// pour rester portable entre SGBD ; taille plafonnée par le paramétrage.
model CaseDocument {
  id         String     @id @default(cuid())
  caseId     String
  ratingCase RatingCase @relation(fields: [caseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fileName   String
  mimeType   String
  sizeBytes  Int
  sha256     String
  content    Bytes
  uploadedBy String
  createdAt  DateTime   @default(now())

  @@index([caseId])
  @@map("case_documents")
}

// Proposition de l'IA pour un champ du formulaire : jamais appliquée sans
// décision humaine, chaque décision est tracée.
model AiProposal {
  id         String     @id @default(cuid())
  caseId     String
  ratingCase RatingCase @relation(fields: [caseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  field      String // ex. criteria.D1.4, structuralFlags.baseDscrBelow1
  value      String     @db.Text // valeur proposée (JSON)
  source     String?    @db.Text // pièce et passage d'où vient la valeur
  rationale  String?    @db.Text
  confidence Int // 0 à 100
  status     String     @default("PENDING") // PENDING | ACCEPTED | REJECTED | SUPERSEDED (remplacée par une nouvelle analyse)
  model      String
  decidedBy  String?
  decidedAt  DateTime?
  createdAt  DateTime   @default(now())

  @@index([caseId, status])
  @@map("ai_proposals")
}
